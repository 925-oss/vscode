{
  "name": "theme-quenchlight",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "10.0.0",
  "publisher": "quenchlight",
  "license": "MIT",
  "engines": {
    "vscode": "*"
  },
  "categories": ["Themes"],
  "contributes": {
    "themes": [
      {
        "id": "Quenchlight",
        "label": "%themeLabel%",
        "uiTheme": "vs-dark",
        "path": "./themes/quenchlight-color-theme.json"
      },
      {
        "id": "Quenchlight Day",
        "label": "%dayThemeLabel%",
        "uiTheme": "vs",
        "path": "./themes/quenchlight-day-color-theme.json"
      },
      {
        "id": "Quenchlight Forge",
        "label": "%forgeThemeLabel%",
        "uiTheme": "vs-dark",
        "path": "./themes/quenchlight-forge-color-theme.json"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/925-oss/vscode.git"
  }
}
