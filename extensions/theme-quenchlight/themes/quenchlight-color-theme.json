  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#85786a", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"], "settings": { "foreground": "#ff6a2b" } },
    { "scope": ["keyword.control.flow", "keyword.control.return", "keyword.control.conditional", "keyword.control.loop", "keyword.control.import", "keyword.control.export", "keyword.control.from"], "settings": { "foreground": "#ff6a2b", "fontStyle": "italic" } },
    { "scope": ["keyword.operator", "keyword.operator.assignment", "keyword.operator.arithmetic", "keyword.operator.logical", "keyword.operator.comparison"], "settings": { "foreground": "#f59a6f" } },
    { "scope": ["keyword.operator.new", "keyword.operator.expression", "keyword.operator.typeof", "keyword.operator.instanceof"], "settings": { "foreground": "#ff6a2b", "fontStyle": "italic" } },
    { "scope": ["punctuation", "meta.brace", "punctuation.separator", "punctuation.terminator", "punctuation.accessor"], "settings": { "foreground": "#9c8e7d" } },
    { "scope": ["string", "punctuation.definition.string"], "settings": { "foreground": "#9fd187" } },
    { "scope": ["string.template", "punctuation.definition.template-expression", "punctuation.section.embedded"], "settings": { "foreground": "#b5dca0" } },
    { "scope": ["constant.character.escape", "string.regexp", "constant.other.character-class.regexp"], "settings": { "foreground": "#b48ae6" } },
    { "scope": ["constant.numeric"], "settings": { "foreground": "#e96259" } },
    { "scope": ["constant.language", "variable.language.this", "variable.language.self", "variable.language.super", "support.constant"], "settings": { "foreground": "#a78bdb", "fontStyle": "italic" } },
    { "scope": ["constant", "variable.other.constant", "variable.other.enummember"], "settings": { "foreground": "#e9b98a" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call entity.name.function", "variable.function"], "settings": { "foreground": "#6b93db" } },
    { "scope": ["entity.name.function.method", "meta.method-call entity.name.function"], "settings": { "foreground": "#93b4ea" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class", "entity.name.namespace", "storage.type.primitive", "support.type.primitive"], "settings": { "foreground": "#f4c46a" } },
    { "scope": ["entity.name.type.interface", "entity.name.type.alias"], "settings": { "foreground": "#f8dc9a", "fontStyle": "italic" } },
    { "scope": ["variable", "variable.other.readwrite", "meta.definition.variable"], "settings": { "foreground": "#e8dece" } },
    { "scope": ["variable.parameter", "meta.parameters variable"], "settings": { "foreground": "#f3c2a0", "fontStyle": "italic" } },
    { "scope": ["variable.other.property", "variable.other.object.property", "support.variable.property", "meta.property.object", "support.type.property-name", "meta.object-literal.key"], "settings": { "foreground": "#6fb2f0" } },
    { "scope": ["support.type.property-name.json"], "settings": { "foreground": "#f4c46a" } },
    { "scope": ["support.type.property-name.json string", "meta.structure.dictionary.value.json string"], "settings": { "foreground": "#9fd187" } },
    { "scope": ["meta.decorator", "punctuation.decorator", "entity.name.function.decorator", "meta.annotation", "storage.type.annotation"], "settings": { "foreground": "#b48ae6", "fontStyle": "italic" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#ff6a2b" } },
    { "scope": ["support.class.component", "entity.name.tag.tsx", "entity.name.tag.jsx"], "settings": { "foreground": "#f4c46a" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#6fb2f0", "fontStyle": "italic" } },
    { "scope": ["punctuation.definition.tag"], "settings": { "foreground": "#9c8e7d" } },
    { "scope": ["entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css"], "settings": { "foreground": "#f4c46a" } },
    { "scope": ["support.type.property-name.css", "support.type.vendored.property-name.css"], "settings": { "foreground": "#6fb2f0" } },
    { "scope": ["support.constant.property-value.css", "keyword.other.unit"], "settings": { "foreground": "#e96259" } },
    { "scope": ["markup.heading", "markup.heading entity.name", "punctuation.definition.heading"], "settings": { "foreground": "#f4c46a", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "foreground": "#ff6a2b", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "foreground": "#b48ae6", "fontStyle": "italic" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#6fb2f0" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code", "markup.raw"], "settings": { "foreground": "#9fd187" } },
    { "scope": ["markup.quote"], "settings": { "foreground": "#9c8e7d", "fontStyle": "italic" } },
    { "scope": ["markup.list punctuation.definition.list"], "settings": { "foreground": "#ff6a2b" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#93c97b" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#e5534b" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#e8a33a" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#e5534b", "fontStyle": "underline" } },
    { "scope": ["source.shell variable.other", "punctuation.definition.variable.shell"], "settings": { "foreground": "#6fb2f0" } },
    { "scope": ["entity.name.section", "entity.name.tag.yaml"], "settings": { "foreground": "#f4c46a" } }
  ],
  "semanticTokenColors": {
    "parameter": { "foreground": "#f3c2a0", "italic": true },
    "property": "#6fb2f0",
    "enumMember": "#e9b98a",
    "variable.readonly": "#e9b98a",
    "variable.defaultLibrary": "#a78bdb",
    "function.defaultLibrary": "#6b93db",
    "class": "#f4c46a",
    "interface": { "foreground": "#f8dc9a", "italic": true },
    "type": "#f4c46a",
    "typeParameter": { "foreground": "#f8dc9a", "italic": true },
    "namespace": "#f4c46a",
    "decorator": { "foreground": "#b48ae6", "italic": true },
    "selfKeyword": { "foreground": "#a78bdb", "italic": true }
  }
}
