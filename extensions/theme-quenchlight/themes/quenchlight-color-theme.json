  "tokenColors": [
    {"name": "Comments: the words written for people", "scope": ["comment", "punctuation.definition.comment", "string.quoted.docstring"], "settings": {"foreground": "#d1bd7d", "fontStyle": ""}},
    {"name": "Syntax skeleton: keywords, operators and punctuation recede", "scope": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.control", "keyword.operator", "punctuation", "meta.brace", "variable.language.this", "variable.language.super", "variable.language.self", "punctuation.definition.tag", "entity.other.attribute-name", "punctuation.definition.template-expression", "punctuation.section.embedded", "meta.tag.metadata.doctype", "entity.other.attribute-name.pseudo-class", "entity.other.attribute-name.pseudo-element"], "settings": {"foreground": "#b2aba2", "fontStyle": ""}},
    {"name": "Strings", "scope": ["string", "punctuation.definition.string", "markup.inline.raw", "markup.fenced_code.block", "markup.raw"], "settings": {"foreground": "#9ed198", "fontStyle": ""}},
    {"name": "Code inside a string is code again", "scope": ["meta.template.expression", "meta.embedded", "meta.interpolation", "string meta.image.inline.markdown"], "settings": {"foreground": "#e5dfd4", "fontStyle": ""}},
    {"name": "Literal values: numbers, booleans, null, enum members, escapes, units, colours", "scope": ["constant.numeric", "constant.language", "constant.character", "constant.other.color", "constant.other.symbol", "constant.other.placeholder", "variable.other.enummember", "support.constant", "keyword.other.unit", "string.regexp", "constant.other.character-class.regexp", "constant.character.escape"], "settings": {"foreground": "#94c2f3", "fontStyle": ""}},
    {"name": "Definitions: the place a function, method or type is declared", "scope": ["entity.name.function", "entity.name.type.class", "entity.name.type.interface", "entity.name.type.alias", "entity.name.type.enum", "entity.name.type.module", "entity.name.type.struct", "entity.name.type.protocol", "entity.name.type.trait", "entity.name.class", "entity.name.struct", "entity.name.section", "entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css", "entity.other.attribute-name.class.mixin"], "settings": {"foreground": "#fea668", "fontStyle": ""}},
    {"name": "Calls are uses, not definitions", "scope": ["meta.function-call entity.name.function", "meta.method-call entity.name.function", "meta.function-call.generic", "support.function", "entity.name.function.decorator", "entity.name.function.macro"], "settings": {"foreground": "#e5dfd4", "fontStyle": ""}},
    {"name": "Keys and tags are structure, left in the text colour", "scope": ["support.type.property-name", "support.type.property-name.json", "entity.name.tag", "support.class.component", "meta.object-literal.key string"], "settings": {"foreground": "#e5dfd4", "fontStyle": ""}},
    {"name": "Markdown headings", "scope": ["markup.heading", "markup.heading entity.name", "punctuation.definition.heading"], "settings": {"foreground": "#fea668", "fontStyle": "bold"}},
    {"name": "Markdown bold", "scope": ["markup.bold"], "settings": {"fontStyle": "bold"}},
    {"name": "Markdown italic", "scope": ["markup.italic"], "settings": {"fontStyle": "italic"}},
    {"name": "Markdown strikethrough", "scope": ["markup.strikethrough"], "settings": {"fontStyle": "strikethrough"}},
    {"name": "Links", "scope": ["markup.underline.link", "string.other.link", "meta.link"], "settings": {"foreground": "#94c2f3", "fontStyle": ""}},
    {"name": "Quotes", "scope": ["markup.quote"], "settings": {"foreground": "#b2aba2", "fontStyle": ""}},
    {"name": "Diff: added", "scope": ["markup.inserted", "punctuation.definition.inserted"], "settings": {"foreground": "#9ed198", "fontStyle": ""}},
    {"name": "Diff: removed", "scope": ["markup.deleted", "punctuation.definition.deleted"], "settings": {"foreground": "#fb817a", "fontStyle": ""}},
    {"name": "Diff: changed", "scope": ["markup.changed", "punctuation.definition.changed"], "settings": {"foreground": "#ebb761", "fontStyle": ""}},
    {"name": "Diff: file and range headers", "scope": ["meta.diff.header", "meta.diff.range", "meta.diff.index"], "settings": {"foreground": "#94c2f3", "fontStyle": ""}},
    {"name": "Invalid", "scope": ["invalid", "invalid.illegal"], "settings": {"foreground": "#fb817a", "fontStyle": ""}}
  ],
