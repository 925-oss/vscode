  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#5b6399", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"], "settings": { "foreground": "#ff8c1a" } },
    { "scope": ["keyword.control.flow", "keyword.control.return", "keyword.control.conditional", "keyword.control.loop", "keyword.control.import", "keyword.control.export", "keyword.control.from"], "settings": { "foreground": "#ff8c1a", "fontStyle": "italic" } },
    { "scope": ["keyword.operator", "keyword.operator.assignment", "keyword.operator.arithmetic", "keyword.operator.logical", "keyword.operator.comparison"], "settings": { "foreground": "#ff9f6b" } },
    { "scope": ["keyword.operator.new", "keyword.operator.expression", "keyword.operator.typeof", "keyword.operator.instanceof"], "settings": { "foreground": "#ff8c1a", "fontStyle": "italic" } },
    { "scope": ["punctuation", "meta.brace", "punctuation.separator", "punctuation.terminator", "punctuation.accessor"], "settings": { "foreground": "#7a82b8" } },
    { "scope": ["string", "punctuation.definition.string"], "settings": { "foreground": "#8ee66b" } },
    { "scope": ["string.template", "punctuation.definition.template-expression", "punctuation.section.embedded"], "settings": { "foreground": "#a6f28f" } },
    { "scope": ["constant.character.escape", "string.regexp", "constant.other.character-class.regexp"], "settings": { "foreground": "#ff7ac6" } },
    { "scope": ["constant.numeric"], "settings": { "foreground": "#ff5f5f" } },
    { "scope": ["constant.language", "variable.language.this", "variable.language.self", "variable.language.super", "support.constant"], "settings": { "foreground": "#b48cff", "fontStyle": "italic" } },
    { "scope": ["constant", "variable.other.constant", "variable.other.enummember"], "settings": { "foreground": "#ffb35c" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call entity.name.function", "variable.function"], "settings": { "foreground": "#6f9dff" } },
    { "scope": ["entity.name.function.method", "meta.method-call entity.name.function"], "settings": { "foreground": "#82acff" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class", "entity.name.namespace", "storage.type.primitive", "support.type.primitive"], "settings": { "foreground": "#ffd23f" } },
    { "scope": ["entity.name.type.interface", "entity.name.type.alias"], "settings": { "foreground": "#ffe57a", "fontStyle": "italic" } },
    { "scope": ["variable", "variable.other.readwrite", "meta.definition.variable"], "settings": { "foreground": "#d6dcf5" } },
    { "scope": ["variable.parameter", "meta.parameters variable"], "settings": { "foreground": "#ffbe98", "fontStyle": "italic" } },
    { "scope": ["variable.other.property", "variable.other.object.property", "support.variable.property", "meta.property.object", "support.type.property-name", "meta.object-literal.key"], "settings": { "foreground": "#5ce1ff" } },
    { "scope": ["support.type.property-name.json"], "settings": { "foreground": "#ffd23f" } },
    { "scope": ["support.type.property-name.json string", "meta.structure.dictionary.value.json string"], "settings": { "foreground": "#8ee66b" } },
    { "scope": ["meta.decorator", "punctuation.decorator", "entity.name.function.decorator", "meta.annotation", "storage.type.annotation"], "settings": { "foreground": "#ff7ac6", "fontStyle": "italic" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#ff8c1a" } },
    { "scope": ["support.class.component", "entity.name.tag.tsx", "entity.name.tag.jsx"], "settings": { "foreground": "#ffd23f" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#5ce1ff", "fontStyle": "italic" } },
    { "scope": ["punctuation.definition.tag"], "settings": { "foreground": "#7a82b8" } },
    { "scope": ["entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css"], "settings": { "foreground": "#ffd23f" } },
    { "scope": ["support.type.property-name.css", "support.type.vendored.property-name.css"], "settings": { "foreground": "#5ce1ff" } },
    { "scope": ["support.constant.property-value.css", "keyword.other.unit"], "settings": { "foreground": "#ff5f5f" } },
    { "scope": ["markup.heading", "markup.heading entity.name", "punctuation.definition.heading"], "settings": { "foreground": "#ffd23f", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "foreground": "#ff8c1a", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "foreground": "#ff7ac6", "fontStyle": "italic" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#5ce1ff" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code", "markup.raw"], "settings": { "foreground": "#8ee66b" } },
    { "scope": ["markup.quote"], "settings": { "foreground": "#7a82b8", "fontStyle": "italic" } },
    { "scope": ["markup.list punctuation.definition.list"], "settings": { "foreground": "#ff8c1a" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#7ee36b" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#ff4d4d" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#ffb020" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#ff4d4d", "fontStyle": "underline" } },
    { "scope": ["source.shell variable.other", "punctuation.definition.variable.shell"], "settings": { "foreground": "#5ce1ff" } },
    { "scope": ["entity.name.section", "entity.name.tag.yaml"], "settings": { "foreground": "#ffd23f" } }
  ],
  "semanticTokenColors": {
    "parameter": { "foreground": "#ffbe98", "italic": true },
    "property": "#5ce1ff",
    "enumMember": "#ffb35c",
    "variable.readonly": "#ffb35c",
    "variable.defaultLibrary": "#b48cff",
    "function.defaultLibrary": "#6f9dff",
    "class": "#ffd23f",
    "interface": { "foreground": "#ffe57a", "italic": true },
    "type": "#ffd23f",
    "typeParameter": { "foreground": "#ffe57a", "italic": true },
    "namespace": "#ffd23f",
    "decorator": { "foreground": "#ff7ac6", "italic": true },
    "selfKeyword": { "foreground": "#b48cff", "italic": true }
  }
}
